FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql://masimple_cicd:masimple_cicd@db:5432/masimple_cicd
TEST_DATABASE_URL=postgresql://masimple_cicd:masimple_cicd@db:5432/masimple_cicd_test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Used by docker-compose's db service; must match the credentials in DATABASE_URL above
POSTGRES_USER=masimple_cicd
POSTGRES_PASSWORD=masimple_cicd
POSTGRES_DB=masimple_cicd

# --- Image Builder module ---

# Fernet key used to encrypt/decrypt credentials stored in the DB: AI provider
# API keys, GitHub tokens (added on /github), and registry tokens (added on
# /registries). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this separate from SECRET_KEY so rotating one doesn't break the other.
CREDENTIAL_ENCRYPTION_KEY=

# Where persistent clones of registered repos live (see "Repo registration &
# persistent clones"). Defaults to ./data/repos inside this app's own
# directory if unset — mount your own persistent storage onto that directory
# yourself if you need clones to survive container recreation; only set this
# if you want them somewhere else entirely.
# REPO_CLONE_ROOT=

# GitHub connections are now added and stored (encrypted) on /github, and
# registry targets (Docker Hub, etc.) on /registries — no env-var
# credentials needed for either.

# Fallback API key for the Qwen AI provider, used only if no key is configured
# in the AI Provider Settings page (that DB value takes precedence when set).
QWEN_API_KEY=
# CLAUDE_API_KEY=
# GEMINI_API_KEY=
